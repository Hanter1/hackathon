# Драйвер БД: sqlite или mysql
DB_DRIVER=sqlite

# SQLite (по умолчанию)
DB_PATH=data/site.db

# MySQL (раскомментируйте и заполните при DB_DRIVER=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASSWORD=your_password

# Messenger (опционально)
# MESSENGER_WINDOW_HOURS=24
# MESSENGER_VERIFY_TOKEN=
# MESSENGER_PAGE_ACCESS_TOKEN=
